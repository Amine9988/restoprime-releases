{
  "name": "restoprime",
  "productName": "RestoPrime",
  "version": "1.0.3",
  "description": "RestoPrime — نظام تسيير المطعم",
  "main": "main.js",
  "author": "RestoPrime",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "dist:trial": "electron-builder --win --config electron-builder.trial.js --publish never"
  },
  "build": {
    "appId": "com.restoprime.app",
    "productName": "RestoPrime",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "lan-server.js",
      "preload.js",
      "index.html",
      "app.js",
      "styles.css",
      "trial-expired.html",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RestoPrime",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Amine9988",
      "repo": "restoprime-releases",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Amine9988/restoprime-releases.git"
  }
}
